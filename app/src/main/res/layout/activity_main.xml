<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Tên khoản chi" />
    <EditText android:id="@+id/edtTenKhoanChi_147"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="VD: Tiền cà phê" android:inputType="text" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="Số tiền (VNĐ)" />
    <EditText android:id="@+id/edtSoTien_147"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="VD: 45000" android:inputType="numberDecimal" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="Ghi chú" />
    <EditText android:id="@+id/edtGhiChu_147"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="Nhập ghi chú" android:inputType="textMultiLine" />

    <CheckBox android:id="@+id/chkDaThanhToan_147"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Đã thanh toán" />

    <Button android:id="@+id/btnThem_147"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:text="Thêm khoản chi" />
    <Button android:id="@+id/btnXemChiTiet_147"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Xem chi tiết khoản chi" />
</LinearLayout>